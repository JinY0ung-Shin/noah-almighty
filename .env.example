# Session token signing/hashing secret. REQUIRED in production.
SESSION_SECRET=change-me-session-secret

# Set to "true" ONLY when serving over HTTPS. It marks the session cookie
# Secure, so the browser sends it back only over HTTPS. Leave unset/false for
# plain-HTTP deployments (e.g. local docker-compose) — otherwise the cookie is
# never returned and you get "세션이 만료되었습니다" right after login.
SECURE_COOKIES=

# The LLM endpoint and its credentials live ONLY in pi-gateway (its admin LLM
# page). Noah reads no ANTHROPIC_* variable.

# Optional. DEPLOYMENT DEFAULT for image input (vision). Set to "off" when the
# serving backend is text-only. Then: chat images are still accepted but reach
# the model only as FILES in the conversation folder (never as image blocks),
# Confluence tools stop returning image blocks, and the standing prompt +
# describe_system tell the avatar not to open images itself (pdftotext for
# PDFs, show_file to display images to the user). That instruction is the only
# guard: nothing at a tool gate stops pi's own `read` on an image path.
# Default: on.
# Tiers that differ from this default (e.g. only Opus is multimodal) are set
# PER MODEL TIER in the admin panel (관리자 → 시스템 → 모델별 이미지 입력).
# MODEL_VISION=off

# ── pi-gateway (bundled: docker-compose.yml includes pi-gateway's compose) ──
# Every agent turn runs on pi-gateway (docs/architecture/pi-runtime.md, README
# "Deployment"). docker-compose.yml FIXES AGENT_RUNTIME=pi, PI_GATEWAY_URL,
# PI_GATEWAY_API_KEY_FILE (a compose secret), PI_WORKSPACES_DIR and
# PI_DECK_SANDBOX for the container — do not set them here for Docker (a
# PI_GATEWAY_API_KEY here next to the compose secret stops the boot).
#
# Values in THIS file (and the shell) win over pi-gateway's own .env inside its
# compose file too, so a key both files read must mean the same thing on both
# sides: LOG_LEVEL, NODE_EXTRA_CA_CERTS (a HOST path, below), NPM_CONFIG_REGISTRY,
# PIP_INDEX_URL, PI_GATEWAY_HOME, PI_GATEWAY_SECRETS. Everything else pi reads
# (SANDBOX_*, MAX_CONCURRENT_TURNS*, GATEWAY_BIND_ADDR, TRUST_PROXY, DOCKER_GID,
# APT_MIRROR_URL, …) stays in pi-gateway's .env. pi's defaults (16 turns, 3 per
# user, 1g sandboxes) fit a small team; size them for your peak first — README
# "Sizing pi-gateway".
#
# The pi-gateway checkout (default: the vendor/pi-gateway git submodule, pinned
# by this repository's commit; relative to this directory, or absolute).
# PI_GATEWAY_DIR=./vendor/pi-gateway
# REQUIRED. pi's data root and secrets dir: the SAME values as pi-gateway's .env
# (`sudo docker/pi/setup-host.sh` reads them from here and writes them there).
# Secrets default to $PI_GATEWAY_HOME/secrets.
PI_GATEWAY_HOME=/srv/pi-gateway
# PI_GATEWAY_SECRETS=/srv/pi-gateway/secrets
# The models the chat composer offers are pi-gateway's own list (configured on
# pi's admin LLM page, where the models and their credentials live); nothing
# here maps them. Picking none runs pi-gateway's DEFAULT model.
# The internal broker ↔ Noah network and the broker's pinned address on it. /mcp
# admits only that address (NOAH_MCP_ALLOWED_CIDRS defaults to it as a /32).
# The default sits outside Docker's default address pools (172.17-31.x, 192.168.x),
# so Docker never auto-allocates over it. Change both when the subnet collides with
# a network the host routes to.
# NOAH_MCP_SUBNET=172.16.248.0/24
# NOAH_MCP_BROKER_IP=172.16.248.10
# Only with native TLS (TLS_CERT_FILE): the broker must reach Noah by the name
# its certificate carries, and trust its CA (NODE_EXTRA_CA_CERTS below).
# NOAH_MCP_PUBLIC_URL=https://noah.corp.example:48787
# NOAH_MCP_HOST_ALIAS=noah.corp.example
# Tag of the deck-capable sandbox image compose builds (noah-almighty/pi-sandbox).
# NOAH_PI_SANDBOX_TAG=latest
# Seconds an idle pi session stays loaded (pi's SESSION_IDLE_SECONDS, which the
# bundle sets from THIS key — a value in pi-gateway's .env is ignored). Reloading
# re-lists every Noah MCP server, the expensive part of a session start, and the
# relayed tool lists (shared MCP, plugins, hex-ssh) refresh only then. pi's own
# default is 300; README "Sizing pi-gateway".
# NOAH_PI_SESSION_IDLE_SECONDS=1800
#
# Running Noah natively (npm run dev) against a pi-gateway instead (AGENT_RUNTIME
# defaults to pi; "local" is the deterministic offline stub for tests):
# AGENT_RUNTIME=pi
# PI_GATEWAY_URL=http://127.0.0.1:8080
# The service key: inline, OR a file holding only the key (trimmed; both set,
# or an unreadable/empty file, stops the boot). Server-only: an inline key is
# scrubbed from the process env after boot, a file's key never enters it.
# PI_GATEWAY_API_KEY=
# PI_GATEWAY_API_KEY_FILE=
# PI_WORKSPACES_DIR=/srv/pi-gateway/workspaces
# NOAH_MCP_PUBLIC_URL=http://10.0.0.5:48787
# NOAH_MCP_ALLOWED_CIDRS=10.0.0.0/24
# PI_DECK_SANDBOX=false

# Server + storage.
PORT=48787
APP_DATA_DIR=/app/data
# SQLite DB + uploaded avatar images live under APP_DATA_DIR.

# Serve the app itself over HTTPS (no fronting proxy needed). Set BOTH to PEM
# paths readable inside the container — docker-compose mounts ./docker/tls to
# /app/tls, so drop the cert/key there on the deploy host. Setting only one of
# the two refuses to boot (no silent plain-HTTP fallback). When enabling, also
# set SECURE_COOKIES=true above, and have users re-download the browser-bridge
# zip so installed extensions learn the new https:// origin.
# TLS_CERT_FILE=/app/tls/fullchain.pem
# TLS_KEY_FILE=/app/tls/privkey.pem

# Internal/default GitHub host used when a plugin or knowledge repo is entered as
# "owner/repo". Knowledge repos must stay on this host; full github.com URLs can
# use the per-user GITHUB_TOKEN setting.
GITHUB_HOST=github.com

# Optional. Path to a PEM CA bundle to trust when GITHUB_HOST is a self-hosted /
# on-prem GitHub Enterprise Server with an internal corporate CA. Applied once at
# startup for Node fetch() and every git clone/push (knowledge repo + plugins).
# create_repo also passes this path to gh as SSL_CERT_FILE. It is appended to the
# system roots for fetch (public hosts keep working); for git it becomes libcurl's
# CA bundle, so include public roots in the file too if you also clone public-host
# repos. Leave empty on github.com, or when the CA is already in the system trust
# store (e.g. baked into the image via the Dockerfile CA_CERT_FILE arg).
# GITHUB_CA_CERT=/etc/ssl/certs/internal-ca.pem

# Optional corporate proxy for Noah's own outbound web access: the `mcp__web__fetch`
# avatar tool (the app process routes it through undici's EnvHttpProxyAgent) and
# the MCP servers Noah relays. List intranet hosts/domain suffixes in NO_PROXY so
# they are fetched directly. Lowercase variants also work. The sandboxes' egress
# is pi-gateway's SANDBOX_EGRESS_ALLOW, not this.
# HTTP_PROXY=http://proxy.corp.example:3128
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=.corp.example,intranet.example.com

# Optional. Extra PEM CA bundle for intranet HTTPS served with a private
# corporate CA, as a HOST path (pi-gateway's meaning — the key is shared, see
# the pi-gateway block above). docker-compose.yml mounts the file read-only into
# Noah (where Node honors it for app fetch, `mcp__web__fetch` and the MCP relays)
# and pi-gateway's compose into its gateway and broker. The file must be readable
# by uid 1000 and 10001 (e.g. 0644). A CA baked in with the CA_CERT_FILE build
# arg covers git/curl, not Node.
# NODE_EXTRA_CA_CERTS=/etc/pki/ca-trust/source/anchors/corp-ca.pem

# Optional. Upstream command used by the app's hex-ssh policy proxy. The Docker
# image installs the package at build time and exposes it as `hex-ssh-mcp` (the
# default), so no runtime npx download is needed. Override only for local dev
# without the global bin.
HEX_SSH_COMMAND=hex-ssh-mcp

# Optional. Deployment-wide Confluence base URL for the app-managed Confluence
# tools. On-prem Server/Data Center usually looks like:
#   https://confluence.your-company.com
# or, if Confluence is hosted under a context path:
#   https://intranet.your-company.com/confluence
# Authentication is NOT stored here: each avatar owner registers a Personal
# Access Token in Settings > 권한·연결 > 시크릿 as CONFLUENCE_PAT.
CONFLUENCE_URL=

# Optional. Override the .env file path loaded at startup (default: .env in cwd).
# Useful when running multiple instances or pointing at an environment-specific file.
# ENV_FILE=.env.production

# Optional. Pino log level: trace | debug | info | warn | error | fatal.
# Defaults to "debug" in development (NODE_ENV != production) and "info" in production.
# LOG_LEVEL=info

# Optional. Wall-clock deadline for ONE scheduled-routine run, in minutes
# (default: 30, minimum 1 — unlike PLUGIN_AUTO_REFRESH_MINUTES below, 0 does not
# disable it; an unattended run must always have a deadline). This is the budget
# for the whole run, model-fallback retries included, and it is also how long the
# "지금 실행" button's HTTP request stays open — keep it below the read timeout of
# any reverse proxy in front of the app.
# ROUTINE_RUN_TIMEOUT_MINUTES=30

# Optional. How many scheduled routines may run at once across the server
# (default: 10), and how many of ONE user's (default: 2; keep it below the
# server-wide cap so one user can't take every slot). Whole numbers >= 1; any
# other value falls back to the default. A due routine over a cap waits for a
# free slot; "지금 실행" is never refused but occupies a slot while it runs.
# ROUTINE_MAX_CONCURRENT_RUNS=10
# ROUTINE_MAX_CONCURRENT_RUNS_PER_USER=2

# Optional. Wall-clock deadline for ONE external task API run (POST
# /api/v1/avatar/tasks), in minutes (default: 300 = 5 hours, minimum 1; 0 does
# not disable it). Covers the whole run, including time waiting on a question and
# any background phase. A single pending request (question, permission, plan
# review or canvas input) still expires after 30 minutes without a response.
# AVATAR_TASK_TIMEOUT_MINUTES=300

# Optional. Path to the directory of built-in skills loaded for every avatar
# (default: <cwd>/default-skills). Override to point at a different skills tree
# when running outside the project root. Keep it INSIDE the app tree (as in
# /app/default-skills): the pptx skill's converter resolves playwright-core by
# walking up from its own directory to the app's node_modules, so a skills tree
# placed elsewhere reports the converter as not installed.
# DEFAULT_PLUGINS_DIR=/app/default-skills

# Optional, DEV BOXES / native checkouts only. The pptx skill's HTML→editable-PPTX
# converter (default-skills/skills/pptx/converter; docs/architecture/pptx-converter.md).
# In the Docker stack decks build inside each user's pi sandbox, whose image
# fixes its own settings (docker/pi-sandbox: one slot per sandbox) — these
# variables do not reach it. On a dev box the converter's own `deck.sh` and the
# server's boot probe read them. Unset means the default shown.
#
# Conversion slots per network namespace. Each running check/build is one
# headless Chromium (~0.4–0.5 GiB peak measured on a dev box). A run waits up to
# NOAH_PPTX_SLOT_WAIT_SECONDS for a free slot (never longer than the budget
# minus 60 s), then exits "busy".
# NOAH_PPTX_MAX_CONCURRENT=2
# NOAH_PPTX_SLOT_WAIT_SECONDS=150
# Total wall-clock budget of ONE check/build in seconds, slot wait included.
# NOAH_PPTX_MAX_SECONDS=540
# Slides per build (a bigger deck is built in parts).
# NOAH_PPTX_MAX_SLIDES=60
# Explicit browser executable (default: the image's
# /usr/lib/chromium/chromium-headless-shell, then /usr/lib/chromium/chromium).
# NOAH_PPTX_CHROMIUM=
# Python that has the pinned converter packages (default: python3). Dev boxes
# point it at a venv — use an ABSOLUTE path, .env values are not ~-expanded.
# Also the fallback for the legacy python-pptx probe: if plain python3 cannot
# import pptx, the server tries this interpreter and tells the avatar to run the
# skill's edit-an-existing-deck scripts with it.
# NOAH_PPTX_PYTHON=
# DEV BOXES ONLY: 1 lets the converter fall back to Playwright's downloaded
# Chromium (~/.cache/ms-playwright). Never set it on a deployment.
# NOAH_PPTX_DEV=
# A native checkout needs BOTH of the two above (no image Chromium or pinned
# packages there). Check with: bash default-skills/skills/pptx/scripts/deck.sh probe
# Abstract-socket lock namespace (default: uid-<uid>); only tests change it.
# NOAH_PPTX_LOCK_NAMESPACE=
# Where the probe reads an image's build-time self-test record (default shown;
# docker/pi-sandbox/Dockerfile writes it).
# NOAH_PPTX_SELFTEST_RECORD=/usr/local/share/noah-almighty/deck-selftest.json

# Optional. Minutes before an enabled avatar plugin clone is refreshed from git
# at the start of a chat/routine turn. Default 10; set 0 to disable automatic
# refresh after the first clone.
# PLUGIN_AUTO_REFRESH_MINUTES=10

# Optional. Set to "true" (or "1"/"on") to add a corporate-policy line to the
# browser-bridge install guide telling users to unpack the extension zip into
# the upload-approved Multimedia folder. Default: hidden.
# BROWSER_BRIDGE_MULTIMEDIA_NOTICE=true

# Optional. DEFAULT browser-control allowlist, comma-separated hostnames or
# `*.wildcards` (no scheme/port; `*.corp.local` never matches the apex). Seeded
# ONCE into a browser whose extension allowlist is still empty — a user-edited
# or managed (enterprise-policy) list is never touched, and users can change it
# afterwards in 설정 → 접근/보안. Entries covering Noah's own host (exact, a
# matching wildcard, or a bare `*`) are dropped before serving: the app UI must
# never become drivable by default.
# BROWSER_ALLOWED_ORIGINS=confluence.corp.example,*.corp.local

# RELEASE MACHINE ONLY — the two settings below are read by
# `npm run build:extension-update`, never by the running server. Leave them
# unset on a deployment.
#
# The Noah address(es) baked into the released extension's
# externally_connectable (comma-separated; a bare origin or a full match
# pattern, "/*" optional). REQUIRED for the policy install channel: Chrome
# enforces externally_connectable before any extension code runs, so a
# policy-installed extension whose manifest lacks the real address can never be
# fixed on the machine — the bridge just fails silently. The manually
# downloaded zip needs none of this (the download route stamps the requesting
# address by itself).
# BROWSER_BRIDGE_ORIGINS=https://noah.example.internal

# Path to the RSA private key that signs extension updates. Keep it OUTSIDE the
# repository and back it up: the extension id and the pinned verify key derive
# from it, so losing it orphans every install.
# BROWSER_EXTENSION_KEY_FILE=~/.noah/browser-bridge-key.pem

# Optional. BUILD-time corporate mirrors for `docker compose build`: compose
# reads this .env for the ${VAR} interpolation in docker-compose.yml's build
# args (exporting them in the shell works too). APT_MIRROR_HOST /
# NPM_CONFIG_REGISTRY cover the Noah image's apt and npm; NPM_CONFIG_REGISTRY,
# PIP_INDEX_URL and PIP_TRUSTED_HOST also feed the deck sandbox image
# (docker/pi-sandbox: playwright-core and the pptx skill's PINNED Python set,
# every pin as a CPython 3.12 wheel). That image's apt follows the mirror
# pi-gateway's own sandbox image was built with (APT_MIRROR_URL in pi-gateway's
# .env), which must then also serve Debian trixie's chromium-headless-shell.
# NPM_CONFIG_REGISTRY and PIP_INDEX_URL reach pi-gateway's image builds too.
# Unset = public upstreams.
#   APT_MIRROR_HOST=mirror.example.internal/repository/proxy-apt-deb.debian.org
#   NPM_CONFIG_REGISTRY=http://mirror.example.internal/repository/proxy-npm-registry.npmjs.org/
#   PIP_INDEX_URL=https://mirror.example.internal/repository/proxy-pypi/simple
#   PIP_TRUSTED_HOST=mirror.example.internal
# APT_MIRROR_HOST=
# NPM_CONFIG_REGISTRY=
# PIP_INDEX_URL=
# PIP_TRUSTED_HOST=

# Optional BUILD arg of the deck sandbox image (same interpolation as above).
# DECK_CONVERTER_STRICT_GOLDEN=1 makes golden drift in its build-time converter
# self-test FAIL the build instead of being recorded
# (README.md#deck-converter-golden-drift).
# DECK_CONVERTER_STRICT_GOLDEN=0

# The FIRST user to sign up becomes the admin. There are no invite codes.
