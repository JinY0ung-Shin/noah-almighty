# Session token signing/hashing secret. REQUIRED in production.
SESSION_SECRET=change-me-session-secret

# Set to "true" ONLY when serving over HTTPS. It marks the session cookie
# Secure, so the browser sends it back only over HTTPS. Leave unset/false for
# plain-HTTP deployments (e.g. local docker-compose) — otherwise the cookie is
# never returned and you get "세션이 만료되었습니다" right after login.
SECURE_COOKIES=

# Claude Agent SDK auth — all ANTHROPIC_* vars are read by the SDK from the
# environment (docker-compose injects the whole .env, so any added later flow
# through too). Set EITHER an API key, OR a base URL + auth token for a gateway/
# proxy. When all are absent, the SDK falls back to local Claude Code auth
# (subscription login), which the container does not have.
#
# Alternatively, leave ANTHROPIC_API_KEY empty and register a Claude subscription
# token from the admin UI (관리자 ▸ 구독 로그인): paste the output of
# `claude setup-token`. It's stored AES-256-GCM-encrypted in the data volume and
# injected as CLAUDE_CODE_OAUTH_TOKEN. A non-empty ANTHROPIC_API_KEY here takes
# precedence over that stored token.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Optional. Pins the Claude model the agent runs (e.g. claude-opus-4-8).
# When absent, the Claude Agent SDK picks its default model. The admin page
# shows both this configured value and the model the SDK actually reported.
# NOTE: when set, this is a HARD lock — the per-conversation model picker in the
# chat composer is hidden and users cannot change the model.
ANTHROPIC_MODEL=

# Optional. The chat composer lets each user pick a model TIER per conversation
# (Fable / Opus / Sonnet / Haiku). These map each tier ALIAS to the concrete model
# id the SDK runs; the picker also shows the mapped id to the user. Leave a tier
# unset to let the SDK resolve that alias to the account default (the app can't
# name it, so the picker shows only the tier label). Opus is the default when
# nothing is picked. Resolution precedence:
#   ANTHROPIC_MODEL (pin, above) > user's per-conversation tier > admin override > Opus (default).
ANTHROPIC_DEFAULT_FABLE_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# Optional. DEPLOYMENT DEFAULT for image input (vision). Set to "off" when the
# serving backend is text-only. Then: chat image uploads are rejected (and the
# composer hides the attach button), the agent's Read on image/PDF files is
# denied with a redirect (pdftotext for PDFs, show_file to display images to
# the user), Confluence tools stop returning image blocks, and the avatar is
# told via the standing prompt + describe_system. Default: on.
# Tiers that differ from this default (e.g. only Opus is multimodal) are set
# PER MODEL TIER in the admin panel (관리자 → 시스템 → 모델별 이미지 입력).
# MODEL_VISION=off

# claude | local
# Default "claude": chat runs through the Claude Agent SDK.
# "local" uses a deterministic offline stub (no plugin execution) — for tests/dev.
AGENT_RUNTIME=claude

# Optional. Statically register read-only external avatars backed by a stateless
# POST /v1/agents/messages endpoint (for example oh-my-gateway). Administrators can
# manage additional encrypted entries in 관리자 ▸ 외부 아바타; an env entry remains
# read-only and wins if the same id exists in both places. The public avatar
# id becomes `external:<id>`. Each request sends the complete stored user/assistant
# history; gateway SDK session ids are ignored. External avatars do NOT use Noah's
# local plugins, repos, MCP controls, model/effort picker, routines, or image input.
# New conversations bind the exact endpoint when created. Pre-migration conversations
# without a binding fail closed, and changing this env address requires a new
# conversation rather than forwarding old history.
# Omit visibleToGroupIds for public access. Set it to a non-empty list of Noah
# group UUIDs to restrict discovery, detail, and new chat turns to current members
# of at least one listed group. This is a Noah visibility ACL only; it does not
# change Gateway tools or grant Noah trust/elevation. Group UUIDs are returned by
# the admin groups API/UI; system-admin status alone does not bypass membership.
#
# Prefer apiKeyEnv over embedding apiKey in this JSON. Set exactly one of endpoint
# (the exact POST URL ending in /v1/agents/messages) or baseUrl (appends that
# suffix). The v1 contract supports only agent=claude. model/system are private
# upstream request fields and are never returned by the avatar APIs.
# Optional safety limits are seconds: connectTimeoutSeconds (default 15),
# idleTimeoutSeconds (default 120), totalTimeoutSeconds (default 1800).
# EXTERNAL_AGENT_RESEARCH_TOKEN=replace-me
# EXTERNAL_AGENTS_JSON=[{"id":"research","displayName":"Research Agent","alias":"리서처","bio":"외부 조사 에이전트","intro":"외부 Gateway에서 실행됩니다.","hashtags":["research"],"baseUrl":"http://oh-my-gateway:8000","apiKeyEnv":"EXTERNAL_AGENT_RESEARCH_TOKEN","agent":"claude","model":"sonnet","system":"Answer as the research avatar.","visibleToGroupIds":["replace-with-noah-group-uuid"],"connectTimeoutSeconds":15,"idleTimeoutSeconds":120,"totalTimeoutSeconds":1800}]
EXTERNAL_AGENTS_JSON=

# Server + storage.
PORT=48787
APP_DATA_DIR=/app/data
# SQLite DB + uploaded avatar images live under APP_DATA_DIR.

# Serve the app itself over HTTPS (no fronting proxy needed). Set BOTH to PEM
# paths readable inside the container — docker-compose mounts ./docker/tls to
# /app/tls, so drop the cert/key there on the deploy host. Setting only one of
# the two refuses to boot (no silent plain-HTTP fallback). When enabling, also
# set SECURE_COOKIES=true above, and have users re-download the browser-bridge
# zip so installed extensions learn the new https:// origin.
# TLS_CERT_FILE=/app/tls/fullchain.pem
# TLS_KEY_FILE=/app/tls/privkey.pem

# Tool allowlist for read-only (unelevated colleague) chat sessions. These tools
# are always auto-approved. Owner and trusted/group-co-member sessions have access
# to a broader elevated tool set (Write/Edit/Bash, repo commit/push, SSH, etc.)
# gated by the PreToolUse hook — see the Security note in README.md.
READONLY_TOOLS=Read,Glob,Grep

# Internal/default GitHub host used when a plugin or knowledge repo is entered as
# "owner/repo". Knowledge repos must stay on this host; full github.com URLs can
# use the per-user GITHUB_TOKEN setting.
GITHUB_HOST=github.com

# Optional. Path to a PEM CA bundle to trust when GITHUB_HOST is a self-hosted /
# on-prem GitHub Enterprise Server with an internal corporate CA. Applied once at
# startup for Node fetch() and every git clone/push (knowledge repo + plugins).
# create_repo also passes this path to gh as SSL_CERT_FILE. It is appended to the
# system roots for fetch (public hosts keep working); for git it becomes libcurl's
# CA bundle, so include public roots in the file too if you also clone public-host
# repos. Leave empty on github.com, or when the CA is already in the system trust
# store (e.g. baked into the image via the Dockerfile CA_CERT_FILE arg).
# GITHUB_CA_CERT=/etc/ssl/certs/internal-ca.pem

# Optional corporate proxy for outbound web access. Used by the `mcp__web__fetch`
# avatar tool (the app process routes it through undici's EnvHttpProxyAgent) and
# inherited by the Claude Agent SDK subprocess (built-in WebFetch/WebSearch and
# API traffic, when your network requires it). List intranet hosts/domain
# suffixes in NO_PROXY so they are fetched directly. Lowercase variants also work.
# HTTP_PROXY=http://proxy.corp.example:3128
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=.corp.example,intranet.example.com

# Optional. Extra PEM CA bundle for intranet HTTPS served with a private
# corporate CA. Node honors it natively (app fetch + `mcp__web__fetch`) and the
# SDK subprocess inherits it (fixes the built-in WebFetch's "self signed
# certificate" failure). When the image was built with the Dockerfile
# CA_CERT_FILE build arg, the file is already baked at the path below.
# NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/extra-proxy-ca.crt

# Optional. Upstream command used by the app's hex-ssh policy proxy. The Docker
# image installs the package at build time and exposes it as `hex-ssh-mcp` (the
# default), so no runtime npx download is needed. Override only for local dev
# without the global bin.
HEX_SSH_COMMAND=hex-ssh-mcp

# Optional. Deployment-wide Confluence base URL for the app-managed Confluence
# tools. On-prem Server/Data Center usually looks like:
#   https://confluence.your-company.com
# or, if Confluence is hosted under a context path:
#   https://intranet.your-company.com/confluence
# Authentication is NOT stored here: each avatar owner registers a Personal
# Access Token in Settings > 권한·연결 > 시크릿 as CONFLUENCE_PAT.
CONFLUENCE_URL=

# Optional. Self-hosted speech-to-text for the chat composer's mic button.
# Leaving STT_URL unset (the default) hides the mic button entirely — the
# feature has no other switch. STT_URL is an OpenAI-COMPATIBLE base URL: the
# server POSTs the recording as multipart to <STT_URL>/audio/transcriptions and
# reads back { text }. Any engine serving that contract drops in with no code
# change — vLLM + Qwen3-ASR on a GPU (the docker-compose `stt` profile, which
# publishes no host port and is reachable only as http://stt:8000),
# speaches/faster-whisper on a CPU-only host, or a future internal STT API.
# STT_MODEL is the model name sent with each request and must match what the
# upstream serves (vLLM's --served-model-name); default: Qwen/Qwen3-ASR-1.7B.
# STT_LANGUAGE is the ISO-639-1 code biasing every transcription; default `ko`,
# because a short Korean utterance is exactly what auto-detection gets wrong.
# Set it to `auto` to send no language at all and let the engine detect one.
# An admin can also set all three at runtime in 관리자 > 시스템 (no redeploy);
# that stored value WINS over these, which remain the fallback it shows.
# STT_URL=http://stt:8000/v1
# STT_MODEL=Qwen/Qwen3-ASR-1.7B
# STT_LANGUAGE=ko

# Optional. Override the .env file path loaded at startup (default: .env in cwd).
# Useful when running multiple instances or pointing at an environment-specific file.
# ENV_FILE=.env.production

# Optional. Pino log level: trace | debug | info | warn | error | fatal.
# Defaults to "debug" in development (NODE_ENV != production) and "info" in production.
# LOG_LEVEL=info

# Optional. Maximum number of agent turns per chat run (default: 1000).
# Lower values bound cost and latency for chatty or tool-heavy skill chains.
# MAX_TURNS=1000

# Optional. Compact the conversation near this many context tokens instead of
# waiting for the model's full context window — lower values keep each turn
# cheaper at the cost of more frequent summarization. Clamped to 100000–1000000
# (the agent CLI silently drops values outside that range); non-numeric or <= 0
# is ignored. Unset: compact near the model's full context window.
# AUTO_COMPACT_WINDOW=200000

# Optional. Wall-clock deadline for ONE scheduled-routine run, in minutes
# (default: 30, minimum 1 — unlike PLUGIN_AUTO_REFRESH_MINUTES below, 0 does not
# disable it; an unattended run must always have a deadline). This is the budget
# for the whole run, model-fallback retries included, and it is also how long the
# "지금 실행" button's HTTP request stays open — keep it below the read timeout of
# any reverse proxy in front of the app.
# ROUTINE_RUN_TIMEOUT_MINUTES=30

# Optional. How many scheduled routines may run at once across the server
# (default: 10), and how many of ONE user's (default: 2; keep it below the
# server-wide cap so one user can't take every slot). Whole numbers >= 1; any
# other value falls back to the default. A due routine over a cap waits for a
# free slot; "지금 실행" is never refused but occupies a slot while it runs.
# ROUTINE_MAX_CONCURRENT_RUNS=10
# ROUTINE_MAX_CONCURRENT_RUNS_PER_USER=2

# Optional. Wall-clock deadline for ONE external task API run (POST
# /api/v1/avatar/tasks), in minutes (default: 300 = 5 hours, minimum 1; 0 does
# not disable it). Covers the whole run, including time waiting on a question and
# any background phase. A single pending request (question, permission, plan
# review or canvas input) still expires after 30 minutes without a response.
# AVATAR_TASK_TIMEOUT_MINUTES=300

# Optional. Wall-clock deadline for ONE unattended 내 봇 run — a queued delegated
# task or a bot routine — in minutes (default: 30, minimum 1). Keep it short: a
# bot routine run holds one of the routine scheduler's slots for its whole
# duration, and a hung bot turn blocks its thread's queue.
# BOT_TASK_TIMEOUT_MINUTES=30

# Optional. Path to the directory of built-in skills loaded for every avatar
# (default: <cwd>/default-skills). Override to point at a different skills tree
# when running outside the project root. Keep it INSIDE the app tree (as in
# /app/default-skills): the pptx skill's converter resolves playwright-core by
# walking up from its own directory to the app's node_modules, so a skills tree
# placed elsewhere reports the converter as not installed.
# DEFAULT_PLUGINS_DIR=/app/default-skills

# Optional. The pptx skill's HTML→editable-PPTX converter
# (default-skills/skills/pptx/converter; docs/architecture/pptx-converter.md).
# Every variable is optional — unset means the default shown. The server passes
# every NOAH_PPTX_* to the converter's boot probe (describe_system reports the
# limits to the avatar), and the agent shell inherits them for `deck.sh`.
#
# Host-wide conversion slots. Each running check/build is one headless Chromium
# (~0.4–0.5 GiB peak measured on a dev box — NOT a production sizing) inside the
# app container. A run waits up to NOAH_PPTX_SLOT_WAIT_SECONDS for a free slot
# (never longer than the budget minus 60 s), then exits "busy".
# NOAH_PPTX_MAX_CONCURRENT=2
# NOAH_PPTX_SLOT_WAIT_SECONDS=150
# Total wall-clock budget of ONE check/build in seconds, slot wait included.
# Keep it below the agent's 600 s foreground Bash ceiling — the agent CLI moves
# a command that outlives the ceiling to the background.
# NOAH_PPTX_MAX_SECONDS=540
# Slides per build (a bigger deck is built in parts).
# NOAH_PPTX_MAX_SLIDES=60
# Explicit browser executable (default: the image's
# /usr/lib/chromium/chromium-headless-shell, then /usr/lib/chromium/chromium).
# NOAH_PPTX_CHROMIUM=
# Python that has the pinned converter packages (default: python3). Dev boxes
# point it at a venv — use an ABSOLUTE path, .env values are not ~-expanded.
# NOAH_PPTX_PYTHON=
# DEV BOXES ONLY: 1 lets the converter fall back to Playwright's downloaded
# Chromium (~/.cache/ms-playwright). Never set it on a deployment.
# NOAH_PPTX_DEV=
# Abstract-socket lock namespace (default: uid-<uid>); only tests change it.
# NOAH_PPTX_LOCK_NAMESPACE=
# Where the probe reads the image's build-time self-test record (default shown;
# the Dockerfile writes it).
# NOAH_PPTX_SELFTEST_RECORD=/usr/local/share/noah-almighty/deck-selftest.json

# Optional. Minutes before an enabled avatar plugin clone is refreshed from git
# at the start of a chat/routine turn. Default 10; set 0 to disable automatic
# refresh after the first clone.
# PLUGIN_AUTO_REFRESH_MINUTES=10

# Optional. Set to "true" (or "1"/"on") to add a corporate-policy line to the
# browser-bridge install guide telling users to unpack the extension zip into
# the upload-approved Multimedia folder. Default: hidden.
# BROWSER_BRIDGE_MULTIMEDIA_NOTICE=true

# Optional. DEFAULT browser-control allowlist, comma-separated hostnames or
# `*.wildcards` (no scheme/port; `*.corp.local` never matches the apex). Seeded
# ONCE into a browser whose extension allowlist is still empty — a user-edited
# or managed (enterprise-policy) list is never touched, and users can change it
# afterwards in 설정 → 접근/보안. Entries covering Noah's own host (exact, a
# matching wildcard, or a bare `*`) are dropped before serving: the app UI must
# never become drivable by default.
# BROWSER_ALLOWED_ORIGINS=confluence.corp.example,*.corp.local

# RELEASE MACHINE ONLY — the two settings below are read by
# `npm run build:extension-update`, never by the running server. Leave them
# unset on a deployment.
#
# The Noah address(es) baked into the released extension's
# externally_connectable (comma-separated; a bare origin or a full match
# pattern, "/*" optional). REQUIRED for the policy install channel: Chrome
# enforces externally_connectable before any extension code runs, so a
# policy-installed extension whose manifest lacks the real address can never be
# fixed on the machine — the bridge just fails silently. The manually
# downloaded zip needs none of this (the download route stamps the requesting
# address by itself).
# BROWSER_BRIDGE_ORIGINS=https://noah.example.internal

# Path to the RSA private key that signs extension updates. Keep it OUTSIDE the
# repository and back it up: the extension id and the pinned verify key derive
# from it, so losing it orphans every install.
# BROWSER_EXTENSION_KEY_FILE=~/.noah/browser-bridge-key.pem

# Optional. Corporate PyPI mirror for uv/uvx in the AGENT shell (the Docker
# image bundles uv; the whole .env reaches the container via compose env_file
# and flows through the server into the agent subprocess env). UV_DEFAULT_INDEX
# replaces PyPI as the default registry; UV_INDEX adds extra indexes
# (space-separated). Standard uv env vars — see the uv docs.
#   UV_DEFAULT_INDEX=https://mirror.example.internal/repository/proxy-pypi/simple
#   UV_INDEX=https://mirror.example.internal/repository/extra-index/simple
# UV_DEFAULT_INDEX=
# UV_INDEX=

# Optional. BUILD-time corporate mirrors for `docker compose build`: compose
# reads this .env for the ${VAR} interpolation in docker-compose.yml's build
# args (exporting them in the shell works too). APT_MIRROR_HOST /
# NPM_CONFIG_REGISTRY cover apt and npm; PIP_INDEX_URL / PIP_TRUSTED_HOST cover
# the build-time pip install of the pptx skill's PINNED Python set
# (default-skills/skills/pptx/converter/requirements.txt). The apt mirror must
# also serve chromium-headless-shell + chromium-common (bookworm-security, or
# bookworm main) for the deck converter, and the PyPI mirror every pinned
# version for CPython 3.11. Unset = public upstreams. Note they ALSO reach the
# runtime container via env_file, so agent-shell pip/npm resolve through the
# same mirrors — usually what you want on a closed network.
#   APT_MIRROR_HOST=mirror.example.internal/repository/proxy-apt-deb.debian.org
#   NPM_CONFIG_REGISTRY=http://mirror.example.internal/repository/proxy-npm-registry.npmjs.org/
#   PIP_INDEX_URL=https://mirror.example.internal/repository/proxy-pypi/simple
#   PIP_TRUSTED_HOST=mirror.example.internal
# APT_MIRROR_HOST=
# NPM_CONFIG_REGISTRY=
# PIP_INDEX_URL=
# PIP_TRUSTED_HOST=

# Optional BUILD args for the deck converter (same interpolation as above).
# DECK_CONVERTER=0 builds a legacy image without Chromium — the pptx skill then
# falls back to python-pptx; use it only when the apt mirror cannot serve
# Chromium. DECK_CONVERTER_STRICT_GOLDEN=1 makes golden drift in the build-time
# converter self-test FAIL the build instead of being recorded and reported at
# runtime (README.md#deck-converter-golden-drift).
# DECK_CONVERTER=1
# DECK_CONVERTER_STRICT_GOLDEN=0

# The FIRST user to sign up becomes the admin. There are no invite codes.
