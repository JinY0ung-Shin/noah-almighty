{
  "name": "noah-almighty",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "vite build",
    "build:extension-update": "tsx scripts/build-browser-extension-update.ts",
    "start": "node dist/server/index.js",
    "pretest": "npm run build:client -- --mode test",
    "test": "vitest run",
    "test:visual": "node tests/run-visual.mjs",
    "test:visual:update": "node tests/run-visual.mjs --update-snapshots",
    "pretest:coverage": "npm run pretest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && npm run lint:client",
    "lint:client": "tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.2.10",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "^12.10.0",
    "cytoscape": "^3.34.0",
    "dompurify": "^3.4.12",
    "express": "^4.19.2",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "pino": "^10.3.1",
    "playwright-core": "1.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.28.0",
    "vega": "^6.2.0",
    "vega-interpreter": "^2.2.1",
    "vega-lite": "^6.4.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
