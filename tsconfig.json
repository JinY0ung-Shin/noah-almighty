{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node", "vitest"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  // client-importing tests are typechecked under tsconfig.client.json (Bundler
  // resolution) — under NodeNext they'd drag src/client's extensionless imports
  // into this program and fail (TS2835).
  "exclude": ["src/client/**", "tests/client-*.test.ts", "tests/react-*.test.tsx"]
}
