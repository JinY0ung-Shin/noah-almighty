node_modules/
dist/
data/
.omx/
.env
# Local copies of the secret file. `.env` matches that name ONLY, so a backup
# like .env.bak-20260927 shows up as untracked and can be committed by accident.
.env.bak*
.env.local
.DS_Store
npm-debug.log*
test-results/
playwright-report/
coverage/
# Operator CA files (CA_CERT_FILE lives directly under docker/ as .crt/.pem); the
# placeholder docker/extra-ca.crt.example stays tracked.
docker/*.crt
docker/*.pem
docker/tls/*
!docker/tls/.gitkeep
.claude.local.md
.claude/worktrees/
.claude/settings.local.json
# Python bytecode and the pptx converter's per-deck scratch dirs (`.build/`).
# The already-tracked docker/egress/__pycache__ .pyc predates this rule and
# stays tracked: ignore rules never untrack a file.
**/__pycache__/
**/*.pyc
**/.build/
# Build output of the dev/CI-only Open XML SDK validator (build it outside the
# repo — see scripts/openxml-validator/README.md).
scripts/openxml-validator/bin/
scripts/openxml-validator/obj/
